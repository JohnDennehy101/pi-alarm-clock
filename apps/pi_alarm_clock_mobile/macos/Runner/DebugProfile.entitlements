<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandbox disabled: this is a personal local-network app, never App
	     Store distributed, and the machine has no Apple development
	     certificate. Ad-hoc signing cannot carry keychain-access-group, which
	     flutter_secure_storage needs inside a sandbox; unsandboxed, the
	     keychain and network require no special entitlements. Re-enable the
	     sandbox (with com.apple.security.network.client and
	     keychain-access-group) only once signing with a real team. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
