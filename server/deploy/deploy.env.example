# Copy to deploy.env (gitignored) and set your Pi's SSH target.
# Values are defaults: an exported variable always takes precedence.
: "${PI_SSH:=user@your-pi-hostname-or-ip}"

# Optional overrides (these have script defaults, only set to change them):
# : "${PI_DIR:=pi-alarm}"       # home-relative directory on the Pi
# : "${PLATFORM:=linux/arm64}"  # linux/arm/v7 for a 32-bit Pi OS
